* { 
    margin: 0; padding: 0; box-sizing: border-box; 
    font-family: system-ui, -apple-system, sans-serif; 
    -webkit-tap-highlight-color: transparent; /* Bỏ highlight xanh khi bấm trên mobile */
}

body { 
    background: #0a0a0c; color: #fff; overflow: hidden; 
    touch-action: manipulation; /* Bỏ delay 300ms khi chạm */
}

/* Tối ưu canvas không nhận click */
#canvas-container {
    position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
    z-index: 0; pointer-events: none;
}
#glitterCanvas { width: 100%; height: 100%; }

/* Nội dung đè lên canvas */
.container { position: relative; z-index: 10; height: 100vh; display: flex; flex-direction: column; }
header { display: flex; justify-content: space-between; padding: 20px 40px; align-items: center; }
.logo { font-size: 24px; font-weight: 900; background: linear-gradient(90deg, #58a6ff, #a371f7); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
.btn-login { color: #fff; text-decoration: none; padding: 10px 20px; border: 1px solid #58a6ff; border-radius: 8px; transition: 0.2s; will-change: transform; }
.btn-login:hover { background: #58a6ff; color: #000; box-shadow: 0 0 15px #58a6ff; }
.hero { flex: 1; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; }
.hero h2 { font-size: 48px; margin-bottom: 10px; text-shadow: 0 0 20px rgba(255,255,255,0.5); }
.hero p { color: #aaa; font-size: 18px; }
